{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "provider": {
    "local-ai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local vLLM",
      "options": {
        "baseURL": "http://172.201.175.1:8000/v1",
        "apiKey": "not-needed",
        "timeout": 3600000
      },
      "models": {
        "Qwen3.8-27B-NVFP4": {
          "name": "Qwen 3.8 27B NVFP4",
          "reasoning": true,
          "interleaved": {
            "field": "reasoning"
          },
          "tool_call": true,
          "temperature": true,
          "attachment": true,
          "limit": {
            "context": 131072,
            "input": 114688,
            "output": 16384
          }
        }
      }
    }
  }
}
